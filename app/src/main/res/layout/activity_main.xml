<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <View
        android:id="@+id/brandBand"
        android:layout_width="0dp"
        android:layout_height="168dp"
        android:background="@drawable/bg_brand_band"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/waveDecor"
        android:layout_width="140dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.55"
        android:contentDescription="@null"
        android:src="@drawable/ic_waveform"
        app:layout_constraintBottom_toBottomOf="@id/brandBand"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="@dimen/screen_pad"
        android:text="@string/app_name"
        android:textAllCaps="true"
        android:textColor="@color/on_brand"
        android:textSize="@dimen/brand_size"
        android:letterSpacing="0.14"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/screen_pad"
        android:text="@string/tagline"
        android:textColor="#B8E6E1"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/textAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/waveDecor" />

    <TextView
        android:id="@+id/textSectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="20dp"
        android:text="@string/locations_heading"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/brandBand"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLocations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingTop="12dp"
        android:paddingBottom="96dp"
        app:layout_constraintTop_toBottomOf="@id/textSectionLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/textSectionLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_waveform"
            android:alpha="0.7"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/empty_locations_title"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/empty_locations_body"
            android:textColor="@color/ink_muted"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabNewScan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginBottom="24dp"
        android:text="@string/new_location"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
