<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_deep"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar & Monster Halo Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.22"
                android:text="SCREENMIND"
                android:textColor="@color/warm_white"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.14"
                android:text="ON-DEVICE AI MEMORY · SNAPDRAGON 8 ELITE"
                android:textColor="@color/cyan"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Monster Halo Indicator -->
        <com.aquascope.ui.HaloIndicatorView
            android:id="@+id/haloIndicator"
            android:layout_width="36dp"
            android:layout_height="52dp"
            android:alpha="0.85" />
    </LinearLayout>

    <!-- On-Device Neural Engine Status & Actions Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_screenmind_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textEngineStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:text="● ON-DEVICE NEURAL BRAIN: ACTIVE"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ask_pill"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="100% OFFLINE"
                android:textColor="@color/amber"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textEngineDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Snapdragon 8 Elite NPU · Local ML Kit OCR · Offline SQLite FTS5 · Zero PC Needed"
            android:textColor="@color/warm_faint"
            android:textSize="10sp" />

        <!-- Quick Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureScreen"
                style="@style/Widget.AquaScope.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📸 Capture Screen"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncScans"
                style="@style/Widget.AquaScope.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="🔄 Sync Sensors"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeedDemo"
                style="@style/Widget.AquaScope.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="✨ Demo"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Query & Chat Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_outline"
            android:hint="Search screen memory or ask AI…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/warm_white"
            android:textColorHint="@color/warm_faint"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            style="@style/Widget.AquaScope.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Search" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAskDesktop"
            style="@style/Widget.AquaScope.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Ask AI" />
    </LinearLayout>

    <!-- Filter Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ask_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="ALL"
            android:textColor="@color/cyan"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/chipFilterDesktop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ask_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="SCREEN OCR"
            android:textColor="@color/warm_faint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/chipFilterAquaScope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ask_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="ACOUSTIC SCANS"
            android:textColor="@color/warm_faint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Content / Results Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/cyan"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="No screen memory recorded yet.\nTap '📸 Capture Screen' or '✨ Demo' to generate episodes."
            android:textColor="@color/warm_faint"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Optional Developer PC Sync (Collapsed by Default) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0AFFFFFF"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnToggleDevSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="▶ Developer Network Sync (Optional PC Link)"
            android:textColor="@color/warm_faint"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/layoutDevSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputServerUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_outline"
                android:hint="http://192.168.1.100:7777"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="@color/warm_white"
                android:textColorHint="@color/warm_faint"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                style="@style/Widget.AquaScope.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Connect"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textStatusIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="OFFLINE"
                android:textColor="@color/warm_faint"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
