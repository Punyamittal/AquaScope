<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_deep"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.22"
                android:text="@string/system_title"
                android:textColor="@color/warm_white"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/system_subtitle"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/neural_core_section"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/neural_core_blurb"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenNeuralCore"
                style="@style/Widget.AquaScope.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/neural_core" />

            <!-- SMRITI Light / Monster Halo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/halo_section_title"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <com.aquascope.ui.HaloIndicatorView
                android:id="@+id/haloIndicator"
                android:layout_width="88dp"
                android:layout_height="130dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/navy"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ocean"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imageMonsterHalo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/halo_photo_cd"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_monster_halo" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/halo_photo_caption"
                android:textColor="@color/warm_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textHaloHardware"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_smriti_panel"
                android:lineSpacingMultiplier="1.3"
                android:padding="14dp"
                android:textColor="@color/warm_muted"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchHaloEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/halo_enable"
                android:textColor="@color/warm_white" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchHaloNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/halo_night"
                android:textColor="@color/warm_white" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchHaloSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/halo_show_sim"
                android:textColor="@color/warm_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/halo_brightness"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrightLow"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/halo_bright_low" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrightMed"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/halo_bright_med" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrightHigh"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/halo_bright_high" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/halo_legend"
                android:textColor="@color/warm_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenHaloSettings"
                style="@style/Widget.AquaScope.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/halo_open_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestHalo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/halo_test_solid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewHalo"
                style="@style/Widget.AquaScope.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/halo_preview" />

            <!-- Local model -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/local_model_title"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/local_model_subtitle"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_smriti_panel"
                android:lineSpacingMultiplier="1.3"
                android:padding="16dp"
                android:textColor="@color/warm_white"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchUseLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/local_model_enable"
                android:textColor="@color/warm_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/local_model_download_title"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/local_model_download_subtitle"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textTokenStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_smriti_panel"
                android:lineSpacingMultiplier="1.3"
                android:padding="12dp"
                android:textColor="@color/warm_white"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputHfTokenLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/local_model_hf_token_hint"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/ocean"
                app:endIconMode="clear_text"
                app:hintTextColor="@color/warm_faint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputHfToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:imeOptions="actionDone"
                    android:textColor="@color/warm_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveToken"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/local_model_save_token" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearToken"
                    style="@style/Widget.AquaScope.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/local_model_clear_token" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetToken"
                    style="@style/Widget.AquaScope.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/local_model_get_token" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcceptLicense"
                    style="@style/Widget.AquaScope.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/local_model_accept_license" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerDownloadModels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Speech · Whisper + Ollama translation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/speech_section_title"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/speech_section_subtitle"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textWhisperStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_smriti_panel"
                android:lineSpacingMultiplier="1.3"
                android:padding="12dp"
                android:textColor="@color/warm_white"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchOllamaTranslate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ollama_translate_enable"
                android:textColor="@color/warm_white" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchGemmaOcr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gemma_ocr_enable"
                android:textColor="@color/warm_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gemma_ocr_hint"
                android:textColor="@color/warm_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/screenmind_section_title"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/screenmind_section_subtitle"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchScreenMind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/screenmind_enable"
                android:textColor="@color/warm_white" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchScreenMindPc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/screenmind_pc_enable"
                android:textColor="@color/warm_white" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputScreenMindPcUrlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/screenmind_pc_url_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputScreenMindPcUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchScreenMindTts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/screenmind_tts_enable"
                android:textColor="@color/warm_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/sarvam_section_title"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sarvam_section_subtitle"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSarvam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sarvam_enable"
                android:textColor="@color/warm_white" />

            <TextView
                android:id="@+id/textSarvamStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSarvamApiKey"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sarvam_set_key" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGemmaOcrModels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="false"
                app:singleSelection="true" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputOllamaUrlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ollama_base_url_hint"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/ocean"
                app:hintTextColor="@color/warm_faint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputOllamaUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:textColor="@color/warm_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputOllamaModelLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ollama_model_hint"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/ocean"
                app:hintTextColor="@color/warm_faint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputOllamaModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textColor="@color/warm_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ollama_model_picks_hint"
                android:textColor="@color/warm_muted"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipOllamaModels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="false"
                app:singleSelection="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveOllama"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ollama_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestOllama"
                    style="@style/Widget.AquaScope.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/ollama_test" />
            </LinearLayout>

            <TextView
                android:id="@+id/textOllamaStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/warm_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/skills_section_title"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/skills_section_subtitle"
                android:textColor="@color/warm_muted"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSkillsMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/skills_master_enable"
                android:textColor="@color/warm_white" />

            <LinearLayout
                android:id="@+id/containerSkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/local_model_import" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportDownloads"
                style="@style/Widget.AquaScope.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/local_model_import_downloads" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReload"
                style="@style/Widget.AquaScope.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/local_model_reload" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemove"
                style="@style/Widget.AquaScope.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/local_model_remove" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/local_model_howto"
                android:textColor="@color/warm_white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textHowto"
                android:layout_width="match_parent"
