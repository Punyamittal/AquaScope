<?xml version="1.0" encoding="utf-8"?>
<!-- Elevated glass card: 20% white — used for active/focused surfaces -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cyan glow halo -->
    <item
        android:bottom="-3dp"
        android:left="-3dp"
        android:right="-3dp"
        android:top="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A4AAFC2" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <!-- Glass elevated fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_elevated" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <!-- Inner shimmer highlight -->
    <item
        android:bottom="22dp"
        android:left="10dp"
        android:right="10dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2AFFFFFF" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
