<?xml version="1.0" encoding="utf-8"?>
<!-- Multi-stop deep gradient: near-black → navy → midnight with faint purple node -->
<!-- Used as the root screen background for glassmorphism depth effect -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:centerColor="#0A102B"
        android:endColor="#071A2B"
        android:startColor="#040E1A"
        android:type="linear" />
</shape>
