<?xml version="1.0" encoding="utf-8"?>
<!-- ScreenMind result card: glass with amber accent glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Amber glow halo -->
    <item
        android:bottom="-3dp"
        android:left="-3dp"
        android:right="-3dp"
        android:top="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1AD99A3A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_panel" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
