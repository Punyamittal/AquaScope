<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism card: 15% white frosted panel with luminous 1dp border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow halo (slightly larger, behind everything) -->
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A4AAFC2" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_panel" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <!-- Inner shimmer highlight at top edge -->
    <item
        android:bottom="22dp"
        android:left="12dp"
        android:right="12dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shimmer" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
