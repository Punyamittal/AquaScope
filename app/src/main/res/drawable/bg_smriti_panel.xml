<?xml version="1.0" encoding="utf-8"?>
<!-- Smriti panel: glass panel for Ask SMRITI and sub-panels -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_panel" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke_soft" />
        </shape>
    </item>
    <!-- Top shimmer -->
    <item
        android:bottom="18dp"
        android:left="10dp"
        android:right="10dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shimmer" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
