<?xml version="1.0" encoding="utf-8"?>
<!-- Glass button: cyan-tinted glass with glow border -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#554AAFC2" />
                    <corners android:radius="28dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#334AAFC2" />
                    <corners android:radius="28dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/cyan_bright" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
