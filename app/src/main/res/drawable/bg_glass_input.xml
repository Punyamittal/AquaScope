<?xml version="1.0" encoding="utf-8"?>
<!-- Glass input field: frosted with cyan accent border -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_elevated" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_panel" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
