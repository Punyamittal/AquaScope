<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">@color/brand_bright</color>
    <color name="background">@color/bg_mist</color>
    <color name="bg_mist">#E4F0EE</color>
    <color name="bg_mist_deep">#C8E0DC</color>
    <color name="brand">#0B4F54</color>
    <color name="brand_bright">#2A9D8F</color>
    <color name="brand_mid">#167A7F</color>
    <color name="hairline">#C5D6D4</color>
    <color name="ink">#122326</color>
    <color name="ink_faint">#8A9A9C</color>
    <color name="ink_muted">#5A6E71</color>
    <color name="on_brand">#F4FFFE</color>
    <color name="primary">@color/brand</color>
    <color name="primary_dark">#083C40</color>
    <color name="ripple">#33167A7F</color>
    <color name="status_alert">#B13A3A</color>
    <color name="status_alert_bg">#F5DADA</color>
    <color name="status_ok">#1F7A4D</color>
    <color name="status_ok_bg">#D8F0E4</color>
    <color name="status_warn">#B56B12</color>
    <color name="status_warn_bg">#F7E8D0</color>
    <color name="surface">#F7FBFA</color>
    <color name="surface_elevated">#FFFFFF</color>
    <dimen name="brand_size">40sp</dimen>
    <dimen name="btn_radius">12dp</dimen>
    <dimen name="row_radius">14dp</dimen>
    <dimen name="score_size">64sp</dimen>
    <dimen name="screen_pad">24dp</dimen>
    <dimen name="section_gap">28dp</dimen>
    <string name="add_point">Scan next point</string>
    <string name="analyzing">Extracting acoustic signature…</string>
    <string name="anomaly_score">Anomaly score</string>
    <string name="app_name">AquaScope</string>
    <string name="done">Done</string>
    <string name="empty_history">No scans recorded yet</string>
    <string name="empty_locations_body">Create a location, set a dry baseline, then compare later scans for moisture anomalies.</string>
    <string name="empty_locations_title">No locations yet</string>
    <string name="generate_report">Generate report</string>
    <string name="history_title">Scan history</string>
    <string name="hold_instruction">Press the phone flat against the wall or pipe so the speaker and mic both touch the surface.</string>
    <string name="locations_heading">Scan locations</string>
    <string name="new_location">New location</string>
    <string name="report_avg">Avg</string>
    <string name="report_detail_heading">Point detail</string>
    <string name="report_eyebrow">Session report</string>
    <string name="report_max">Max</string>
    <string name="report_points">Points</string>
    <string name="scanning">Listening to the surface…</string>
    <string name="set_baseline">Save as baseline</string>
    <string name="share_report">Share report</string>
    <string name="start_scan">Start scan</string>
    <string name="tagline">Acoustic moisture sensing</string>
    <string name="view_report">View session report</string>
    <style name="Text.AquaScope.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="Text.AquaScope.Brand" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">@dimen/brand_size</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.AquaScope.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.AquaScope.Score" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/score_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Theme.AquaScope" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/brand_bright</item>
        <item name="colorAccent">@color/brand_bright</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/bg_mist</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="materialButtonStyle">@style/Widget.AquaScope.Button</item>
    </style>
    <style name="Widget.AquaScope.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/btn_radius</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="Widget.AquaScope.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_mid</item>
    </style>
    <style name="Widget.AquaScope.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/btn_radius</item>
        <item name="strokeColor">@color/brand</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>