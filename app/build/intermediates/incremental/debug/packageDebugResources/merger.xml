per Tiny, then enable Ollama translation for non-English voice.\n4. Turn on agent skills for Wikipedia / hash / email / kitchen adventure.\n5. Turn on “Use local model when available”, then open Ask SMRITI.\n\nAsk still works with rules if no model is installed. Never rely on the model for leak confirmation.</string><string name="memory_timeline">MEMORY</string><string name="memory_subtitle">Everything your home has remembered.</string><string name="view_memory">View memory</string><string name="view_evidence">View evidence</string><string name="explore_memory">Explore memory</string><string name="physical_memory">PHYSICAL MEMORY</string><string name="recent_memory">RECENT MEMORY</string><string name="home_status">HOME STATUS</string><string name="locations_heading">ACOUSTIC SCAN</string><string name="scan_section_subtitle">Hold the bottom of the phone flush against a wall or pipe so the bottom speaker and mic both touch the surface.</string><string name="scan_places_eyebrow">PLACES IN MEMORY</string><string name="scan_empty_eyebrow">AQUASCOPE</string><string name="scan_summary_places">%1$d places · %2$d calibrated</string><string name="scan_summary_one">1 place · %1$d calibrated</string><string name="scan_last_observation">Last observation · %1$s · %2$s</string><string name="scan_no_observations">No observations yet — scan a calibrated place.</string><string name="scan_action">Scan</string><string name="history_action">History</string><string name="remove_action">Remove</string><string name="scan_pill_baseline">BASELINE</string><string name="scan_pill_ready">READY</string><string name="scan_pill_watch">WATCH</string><string name="scan_pill_alert">ANOMALY</string><string name="scan_info_needs_baseline">Scan once while dry to calibrate this place</string><string name="scan_info_ready">%d baseline samples · ready to compare</string><string name="scan_info_observed">%1$d scans · last %2$d%% · %3$s</string><string name="empty_locations_title">No places yet</string><stri